<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Privacy Policy | WebRite</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='25' fill='%232F5BFF'/><path d='M20 36 L35 70 L50 46 L65 70 L84 25' fill='none' stroke='white' stroke-width='9' stroke-linecap='round' stroke-linejoin='round'/></svg>">
<meta name="description" content="WebRite Privacy Policy. We never sell, rent, or trade your personal information. Learn what we collect through our quote form, how we use it, and your choices.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --blue:#2F5BFF;
  --ink:#0B0B12;
  --bg:#EEF0F4;
  --white:#FFFFFF;
  --muted:#5A5F6E;
  --line:#D9DCE4;
}

*{ box-sizing:border-box; }

html,body{
  margin:0;
  padding:0;
  overflow-x:hidden;
  background:var(--bg);
  color:var(--ink);
  font-family:Inter,Arial,sans-serif;
  line-height:1.5;
}

/* SITE MENU */

.site-nav{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid var(--line)}
.site-nav .in{max-width:1100px;margin:auto;padding:12px 22px;display:flex;align-items:center;justify-content:space-between;gap:10px 16px;flex-wrap:wrap}
.site-nav .logo{display:flex;align-items:center;gap:8px;text-decoration:none;color:var(--ink);font:700 22px "Space Grotesk",Inter,sans-serif;letter-spacing:-1px}
.site-nav .logo b{color:var(--blue);font-weight:700}
.site-nav nav{display:flex;flex-wrap:wrap;align-items:center;gap:6px 18px}
.site-nav nav a{color:var(--ink);text-decoration:none;font:600 14px Inter,sans-serif}
.site-nav nav a:hover,.site-nav nav a[aria-current="page"]{color:var(--blue)}
.site-nav nav a.nav-cta{background:var(--blue);color:#fff;padding:8px 16px;border-radius:50px}
.site-nav nav a.nav-cta:hover{background:#2146DC;color:#fff}
@media(max-width:560px){.site-nav .in{padding:10px 18px}.site-nav nav{gap:6px 14px}.site-nav nav a{font-size:13px}.site-nav nav a.nav-cta{padding:6px 12px}}

.wrap{
  max-width:1050px;
  margin:0 auto;
  padding:35px 22px 40px;
}

h1,h2,h3,.brand{ font-family:"Space Grotesk",sans-serif; }

/* BRAND */

.brand{
  font-size:42px;
  font-weight:700;
  letter-spacing:-2px;
  line-height:1.1;
}

.brand span{ color:var(--blue); }

.tagline{
  font-size:11px;
  font-weight:700;
  letter-spacing:3px;
  color:var(--blue);
}

/* HEADER */

.header{
  padding-bottom:30px;
  border-bottom:1px solid var(--line);
}

.header h1{
  font-size:clamp(32px,5vw,44px);
  margin:25px 0 12px;
  letter-spacing:-1px;
  line-height:1.1;
}

.header p{
  color:var(--muted);
  max-width:720px;
  margin:0 0 12px;
}

.header .lead{
  font-size:17px;
  color:var(--ink);
  font-weight:500;
}

.back{
  display:inline-block;
  margin-top:16px;
  color:var(--blue);
  text-decoration:none;
  font-weight:700;
  font-size:14px;
}

.back:hover{ text-decoration:underline; }

/* INTRO */

.intro{
  margin-top:30px;
  padding:26px;
  background:white;
  border:1px solid var(--line);
  border-radius:18px;
}

.intro h2{
  font-size:25px;
  margin:0 0 10px;
  letter-spacing:-.5px;
}

.intro p{
  color:var(--muted);
  font-size:14px;
  margin:0;
  max-width:850px;
}

/* PROMISES */

.promises{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:15px;
  margin-top:20px;
}

.promise{
  background:white;
  border:1px solid var(--line);
  border-radius:16px;
  padding:21px;
}

.promise .icon{
  width:38px;
  height:38px;
  border-radius:11px;
  background:#EDF1FF;
  color:var(--blue);
  display:grid;
  place-items:center;
  margin-bottom:12px;
}

.promise .icon svg{ width:20px; height:20px; }

.promise h3{ margin:0 0 6px; font-size:18px; }

.promise p{ margin:0; color:var(--muted); font-size:13px; }

@media(max-width:800px){ .promises{ grid-template-columns:1fr; } }

/* SECTION HEADINGS */

.section-title{
  font-size:28px;
  margin:35px 0 17px;
  letter-spacing:-.6px;
}

.section-note{
  color:var(--muted);
  font-size:14px;
  margin:-7px 0 17px;
}

/* FAQ ACCORDION */

.faq-group{
  display:grid;
  gap:12px;
}

.faq{
  background:white;
  border:1px solid var(--line);
  border-radius:15px;
}

.faq[open]{ border-color:#A9B8FF; }

.faq summary{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
  padding:19px 22px;
  cursor:pointer;
  list-style:none;
  font-size:15px;
  font-weight:700;
  color:var(--ink);
}

.faq summary::-webkit-details-marker{ display:none; }

.faq summary:focus-visible{
  outline:3px solid var(--blue);
  outline-offset:2px;
  border-radius:15px;
}

.faq summary::after{
  content:"+";
  flex:none;
  width:29px;
  height:29px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:9px;
  background:#EDF1FF;
  color:var(--blue);
  font-family:"Space Grotesk",sans-serif;
  font-size:21px;
  font-weight:700;
}

.faq[open] summary::after{
  content:"\2212";
  background:var(--blue);
  color:white;
}

.faq-answer{
  padding:0 22px 20px;
  color:var(--muted);
  font-size:14px;
  line-height:1.75;
}

.faq-answer p{ margin:0 0 12px; }
.faq-answer p:last-child{ margin-bottom:0; }

.faq-answer ul{
  margin:8px 0 12px;
  padding-left:20px;
}

.faq-answer li{ margin:7px 0; }

.faq-answer strong{ color:var(--ink); }

.faq-answer a{
  color:var(--blue);
  font-weight:700;
  text-decoration:none;
}

.faq-answer a:hover{ text-decoration:underline; }

/* PRICING */

.pricing{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:14px;
  margin-top:20px;
}

.price-card{
  background:white;
  border:1px solid var(--line);
  border-radius:16px;
  padding:21px;
  min-width:0;
}

.price-card h3{
  font-size:19px;
  margin:0 0 9px;
}

.price-card .amount{
  color:var(--blue);
  font-family:"Space Grotesk",sans-serif;
  font-size:23px;
  font-weight:700;
  letter-spacing:-.5px;
}

.price-card .monthly{
  color:var(--muted);
  font-size:12px;
  margin-top:10px;
}

.price-card.featured{
  border:2px solid var(--blue);
  padding:20px;
}

.price-note{
  color:var(--muted);
  font-size:12px;
  margin:13px 0 0;
}

/* CTA */

.cta{
  margin-top:38px;
  background:var(--ink);
  color:white;
  border-radius:18px;
  padding:28px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:22px;
}

.cta h2{
  font-size:27px;
  margin:0 0 8px;
}

.cta p{
  color:#C9CCD6;
  font-size:14px;
  margin:0;
  max-width:560px;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:48px;
  padding:0 23px;
  background:var(--blue);
  color:white;
  border:0;
  border-radius:999px;
  font:700 15px Inter,sans-serif;
  text-decoration:none;
  white-space:nowrap;
}

.btn:hover{ background:#2146DC; }

/* FOOTER */

.footer{
  margin-top:50px;
  padding-top:25px;
  border-top:1px solid var(--line);
  display:flex;
  flex-wrap:wrap;
  justify-content:space-between;
  align-items:flex-start;
  gap:20px;
}

.footer .brand{ font-size:42px; }

.footer-links{
  display:flex;
  flex-wrap:wrap;
  gap:8px 18px;
}

.footer a{
  color:var(--blue);
  text-decoration:none;
  font-size:14px;
  font-weight:600;
}

.footer a:hover{ text-decoration:underline; }

.footer p{
  width:100%;
  font-size:12px;
  color:var(--muted);
  margin:0;
}

/* TABLET */

@media(max-width:900px){
  .pricing{ grid-template-columns:repeat(2,minmax(0,1fr)); }
}

/* MOBILE */

@media(max-width:560px){
  .wrap{ padding:25px 18px 30px; }
  .header h1{ font-size:32px; }
  .header{ padding-bottom:23px; }
  .intro{
    margin-top:23px;
    padding:20px;
  }
  .intro h2{ font-size:23px; }
  .section-title{
    font-size:25px;
    margin:30px 0 15px;
  }
  .faq-group{ gap:10px; }
  .faq summary{
    padding:17px;
    font-size:14px;
  }
  .faq-answer{
    padding:0 17px 18px;
    font-size:13px;
  }
  .pricing{
    grid-template-columns:1fr;
    gap:12px;
  }
  .price-card{ padding:19px; }
  .price-card.featured{ padding:18px; }
  .cta{
    flex-direction:column;
    align-items:flex-start;
    margin-top:30px;
    padding:23px;
  }
  .cta h2{ font-size:24px; }
  .btn{ width:100%; }
  .footer{
    margin-top:35px;
    padding-top:20px;
    gap:16px;
  }
  .footer .brand{ font-size:36px; }
  .footer a{ font-size:13px; }
}
</style>
</head>

