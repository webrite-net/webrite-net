<!-- WEBRITE GET A QUOTE PAGE | Google Sites Embed -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --blue:#2F5BFF;
  --ink:#0B0B12;
  --bg:#EEF0F4;
  --white:#FFFFFF;
  --muted:#5A5F6E;
  --line:#D9DCE4;
}
*{box-sizing:border-box}
html,body{
  margin:0;
  padding:0;
  height:auto;
  overflow-x:hidden;
  background:var(--bg);
  color:var(--ink);
  font-family:Inter,Arial,sans-serif;
  line-height:1.5;
}
.wrap{
  max-width:1050px;
  margin:auto;
  padding:35px 22px 90px;
}
h1,h2,h3,.brand{
  font-family:"Space Grotesk",sans-serif;
}
.brand{
  font-size:42px;
  font-weight:700;
  letter-spacing:-2px;
}
.brand span{color:var(--blue)}
.tagline{
  font-size:11px;
  font-weight:700;
  letter-spacing:3px;
  color:var(--blue);
}
.header{
  padding-bottom:30px;
  border-bottom:1px solid var(--line);
}
.header h1{
  font-size:clamp(32px,5vw,44px);
  margin:25px 0 12px;
  letter-spacing:-1px;
}
.header p{
  color:var(--muted);
  max-width:680px;
}
.back{
  display:inline-block;
  margin-top:16px;
  color:var(--blue);
  text-decoration:none;
  font-weight:700;
  font-size:14px;
}
h2{
  font-size:28px;
  margin:35px 0 17px;
}
.plans{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:15px;
}
.plan{
  background:white;
  border:1px solid var(--line);
  border-radius:18px;
  padding:20px;
}
.plan.featured{border:2px solid var(--blue)}
.plan h3{margin:0 0 7px;font-size:19px}
.price{
  color:var(--blue);
  font-size:27px;
  font-weight:700;
  font-family:"Space Grotesk",sans-serif;
}
.price small{
  color:var(--muted);
  font-size:13px;
  font-family:Inter,sans-serif;
  font-weight:400;
}
.monthly{font-size:13px;font-weight:600}
.plan ul{
  padding-left:18px;
  font-size:13px;
}
.plan li{margin:7px 0}
.note{
  font-size:13px;
  color:var(--muted);
  margin:16px 0;
}
.book{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:20px;
  align-items:start;
}
.panel{
  background:white;
  border:1px solid var(--line);
  border-radius:18px;
  padding:23px;
  display:grid;
  gap:15px;
  min-width:0;
}
.panel h3{
  margin:0;
  font-size:19px;
}
.side{
  display:grid;
  gap:20px;
  min-width:0;
}
.row{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:12px;
}
label{
  display:block;
  font-size:14px;
  font-weight:600;
  margin-bottom:6px;
}
input[type=text],
input[type=tel],
input[type=email],
select,
textarea{
  width:100%;
  min-width:0;
  min-height:45px;
  padding:12px 13px;
  border:1px solid var(--line);
  border-radius:12px;
  background:#FAFBFC;
  color:var(--ink);
  font:inherit;
  font-size:14px;
}
textarea{
  min-height:95px;
  resize:vertical;
}
.check{
  display:flex;
  align-items:flex-start;
  gap:10px;
  font-size:14px;
  font-weight:500;
  margin:7px 0;
}
.check input{
  width:19px;
  height:19px;
  accent-color:var(--blue);
  flex:none;
}
.total{
  background:var(--ink);
  color:white;
  border-radius:18px;
  padding:25px;
}
.total h3{
  margin:0 0 12px;
  font-size:17px;
}
.amt{
  font-family:"Space Grotesk",sans-serif;
  font-size:40px;
  font-weight:700;
  line-height:1.1;
}
.breakdown{
  list-style:none;
  padding:0;
  margin:15px 0 0;
}
.breakdown li{
  display:flex;
  justify-content:space-between;
  gap:12px;
  padding:8px 0;
  border-bottom:1px solid #33343C;
  font-size:13px;
}
.breakdown li span:last-child{
  text-align:right;
}
.btn{
  width:100%;
  border:0;
  border-radius:50px;
  min-height:52px;
  background:var(--blue);
  color:white;
  font:700 16px Inter,sans-serif;
  cursor:pointer;
}
.btn:disabled{opacity:.6}
.small{
  font-size:12px;
  color:var(--muted);
  margin:0;
}
.msg{
  padding:15px;
  border-radius:12px;
  font-size:14px;
  font-weight:600;
}
.msg.ok{
  background:#E7F6EC;
  border:1px solid #6CC08A;
}
.msg.err{
  background:#FDECEA;
  border:1px solid #E58A80;
}
.footer{
  margin-top:50px;
  padding-top:25px;
  border-top:1px solid var(--line);
  display:flex;
  flex-wrap:wrap;
  justify-content:space-between;
  gap:20px;
}
.footer a{
  color:var(--blue);
  text-decoration:none;
  font-size:14px;
  font-weight:600;
}
.footer p{
  width:100%;
  font-size:12px;
  color:var(--muted);
}
@media(max-width:700px){
  .book{grid-template-columns:1fr}
}
@media(max-width:560px){
  .wrap{padding:25px 18px 75px}
  .row{grid-template-columns:1fr}
  .plans{grid-template-columns:1fr}
  .panel{padding:19px}
  .header h1{font-size:32px}
  .amt{font-size:35px}
}
</style>

<div class="wrap">

<header class="header">
  <div class="brand">Web<span>Rite</span></div>
  <div class="tagline">WEBSITES THAT WORK</div>

  <h1>Get Your Website Quote</h1>

  <p>
    Tell us about your business and the website you need.
    Choose a package, select your preferred features,
    and submit your request.
    We'll review your project and follow up with a personalized quote.
  </p>

  <a class="back"
     href="https://www.webrite.net"
     target="_top">
     ← Back to Homepage
  </a>
</header>

<h2>Choose Your Website Package</h2>

<div class="plans" id="plans"></div>

<p class="note" id="policy"></p>

<h2>Tell Us About Your Project</h2>

<form id="bookForm" class="book" novalidate>

  <div class="panel">

    <h3>Your Website</h3>

    <div>
      <label for="pkg">Website Package *</label>
      <select id="pkg" required></select>
    </div>

    <div class="row">

      <div>
        <label for="when">When Do You Want to Launch? *</label>
        <select id="when" required></select>
      </div>

      <div>
        <label for="site">Current Website (If Any)</label>
        <input id="site"
               type="text"
               placeholder="yourbusiness.com">
      </div>

    </div>

    <div>
      <label for="what">What Does Your Business Do? *</label>
      <input id="what"
             type="text"
             placeholder="Describe your business"
             required>
    </div>

    <div id="addons"></div>

  </div>

  <div class="side">

    <div class="total" aria-live="polite">
      <h3>Your Selected Package</h3>
      <div class="amt" id="amt">$0</div>
      <ul class="breakdown" id="breakdown"></ul>
    </div>

    <div class="panel">

      <h3>Your Contact Information</h3>

      <div class="row">

        <div>
          <label for="name">Full Name *</label>
          <input id="name"
                 type="text"
                 autocomplete="name"
                 required>
        </div>

        <div>
          <label for="biz">Business Name *</label>
          <input id="biz"
                 type="text"
                 autocomplete="organization"
                 required>
        </div>

      </div>

      <div class="row">

        <div>
          <label for="phone">Phone Number *</label>
          <input id="phone"
                 type="tel"
                 autocomplete="tel"
                 required>
        </div>

        <div>
          <label for="email">Email Address *</label>
          <input id="email"
                 type="email"
                 autocomplete="email"
                 required>
        </div>

      </div>

      <div>
        <label for="notes">
          Anything Else We Should Know?
        </label>

        <textarea id="notes"
                  placeholder="Preferred colors, websites you like, special features, etc."></textarea>
      </div>

      <label class="check">
        <input id="consent"
               type="checkbox"
               required>
        <span>
          WebRite may contact me by phone, text,
          and email regarding my website request.
        </span>
      </label>

      <button class="btn"
              id="submitBtn"
              type="submit">
        Get My Quote →
      </button>

      <div id="formMsg" role="status"></div>

      <p class="small">
        We'll review your request and follow up
        within one business day.
      </p>

    </div>

  </div>

</form>

<footer class="footer">

  <div>
    <div class="brand">Web<span>Rite</span></div>
    <div class="tagline">WEBSITES THAT WORK</div>
  </div>

  <div>
    <a href="https://www.webrite.net"
       target="_top">Home</a>
    &nbsp; · &nbsp;
    <a href="https://www.webrite.net/meet-the-builder"
       target="_top">Meet the Builder</a>
    &nbsp; · &nbsp;
    <a href="https://www.webrite.net/privacy"
       target="_top">Privacy</a>
  </div>

  <p>
    © 2026 WebRite · Websites That Work.
    Serving Riverside, the Inland Empire, Los Angeles,
    Orange County, San Diego & beyond.
  </p>

</footer>

</div>

<script>
/*
  IMPORTANT:
  Replace null with your actual Google Forms mapping
  generated by exportFormMap().
*/
const FORM_MAP = null;

const CONFIG = {
  packages:[
    {
      id:"Solo",
      setup:"$199–$299",
      monthly:"Optional $0–$35/mo",
      featured:false,
      perks:[
        "Essential one-page website",
        "Mobile-friendly design",
        "Contact form",
        "Custom domain connection",
        "HTTPS included",
        "No custom email included"
      ]
    },
    {
      id:"Starter",
      setup:"$399–$599",
      monthly:"Optional $25–$75/mo",
      featured:true,
      perks:[
        "Premium customized website",
        "Service sections, gallery and FAQs",
        "Lead capture forms",
        "Custom domain connection",
        "Optional branded email setup",
        "Optional maintenance and updates"
      ]
    },
    {
      id:"Growth",
      setup:"$599–$899",
      monthly:"Optional $75–$129/mo",
      featured:false,
      perks:[
        "Everything in Starter",
        "Multi-page website when needed",
        "Booking or estimate workflows",
        "Local SEO foundations",
        "Optional professional email setup"
      ]
    },
    {
      id:"Automation",
      setup:"$699–$1,200+",
      monthly:"Optional $99–$199+/mo",
      featured:false,
      perks:[
        "Custom business website",
        "Instant quotes and booking workflows",
        "Automated lead notifications",
        "CRM, email or SMS integrations",
        "Optional branded email setup",
        "Third-party usage billed separately"
      ]
    }
  ],

  features:[
    "Contact form",
    "Online booking",
    "Instant quotes / price calculator",
    "Photo gallery",
    "Google Business Profile setup",
    "Review requests",
    "Lead text alerts",
    "AI chat",
    "Online payments",
    "Professional branded email setup"
  ],

  launch:[
    "ASAP",
    "Within 2 weeks",
    "Within a month",
    "Just exploring"
  ],

  policy:
    "One-time website setup. Monthly care is optional. " +
    "Domain renewals, paid mailboxes, SMS and third-party " +
    "tools are billed separately when applicable. " +
    "Professional email setup is optional beginning with Starter."
};

const $=id=>document.getElementById(id);

const esc=s=>String(s).replace(/[&<>"']/g,c=>({
  "&":"&amp;",
  "<":"&lt;",
  ">":"&gt;",
  '"':"&quot;",
  "'":"&#39;"
}[c]));

const items=(FORM_MAP&&FORM_MAP.items)||{};

const choicesFor=(title,fallback)=>{
  const item=items[title];
  return item&&Array.isArray(item.choices)&&item.choices.length
    ?item.choices
    :fallback;
};

/* RENDER PACKAGES */
$("plans").innerHTML=CONFIG.packages.map(p=>`
  <article class="plan ${p.featured?"featured":""}">
    <h3>${p.id}${p.featured?" · Most Popular":""}</h3>
    <div class="price">
      ${p.setup}<small> setup</small>
    </div>
    <div class="monthly">${p.monthly}</div>
    <ul>
      ${p.perks.map(x=>`<li>${esc(x)}</li>`).join("")}
    </ul>
  </article>
`).join("");

$("policy").textContent=CONFIG.policy;

/* PLAN SELECTOR */
const planChoices=choicesFor(
  "Plan",
  CONFIG.packages.map(p=>
    `${p.id} (${p.setup} setup, ${p.monthly})`
  ).concat(["Not sure, help me choose"])
);

$("pkg").innerHTML=planChoices.map(c=>`
  <option value="${esc(c)}"
    ${c.startsWith("Starter")?"selected":""}>
    ${esc(c)}
  </option>
`).join("");

/* LAUNCH SELECTOR */
$("when").innerHTML=
  '<option value="">Choose one</option>'+
  choicesFor(
    "When do you want to launch?",
    CONFIG.launch
  ).map(v=>`
    <option value="${esc(v)}">${esc(v)}</option>
  `).join("");

/* FEATURES */
$("addons").innerHTML=
  '<label>Features You Want</label>'+
  choicesFor(
    "Features you want",
    CONFIG.features
  ).map(f=>`
    <label class="check">
      <input type="checkbox" value="${esc(f)}">
      <span>${esc(f)}</span>
    </label>
  `).join("");

/* Prevent branded email from being selected with Solo */
function syncFeatures(){
  const solo=$("pkg").value.startsWith("Solo");

  document.querySelectorAll(
    '#addons input[type="checkbox"]'
  ).forEach(cb=>{
    if(cb.value==="Professional branded email setup"){
      cb.disabled=solo;
      if(solo)cb.checked=false;

      const label=cb.closest("label");
      if(label)label.style.opacity=solo?".45":"1";
    }
  });
}

/* PRICING SUMMARY */
function calc(){
  syncFeatures();

  const p=CONFIG.packages.find(x=>
    $("pkg").value.startsWith(x.id)
  );

  const selected=[
    ...document.querySelectorAll(
      '#addons input[type="checkbox"]:checked'
    )
  ].map(cb=>cb.value);

  $("amt").textContent=p?p.setup:"Custom Quote";

  const lines=p
    ?[
      ["Package",p.id],
      ["One-Time Setup",p.setup],
      ["Optional Care",p.monthly]
    ]
    :[
      ["Package","We'll recommend one"]
    ];

  if(selected.length){
    lines.push(["Features Selected",String(selected.length)]);
  }

  if(selected.includes("Professional branded email setup")){
    lines.push(["Email Setup","Quoted separately"]);
  }

  $("breakdown").innerHTML=lines.map(([a,b])=>`
    <li>
      <span>${esc(a)}</span>
      <span>${esc(b)}</span>
    </li>
  `).join("");
}

document.querySelectorAll(
  "#bookForm select,#bookForm input"
).forEach(el=>{
  el.addEventListener("input",calc);
  el.addEventListener("change",calc);
});

calc();

/* GOOGLE FORMS SUBMISSION */
function setMsg(kind,text){
  $("formMsg").innerHTML=text
    ?`<div class="msg ${kind}">${esc(text)}</div>`
    :"";
}

$("bookForm").addEventListener("submit",async e=>{
  e.preventDefault();
  setMsg("","");

  if(!FORM_MAP||!FORM_MAP.action){
    setMsg(
      "err",
      "The quote form is not connected yet."
    );
    return;
  }

  const form=$("bookForm");

  if(!form.checkValidity()){
    const invalid=form.querySelector(":invalid");

    setMsg(
      "err",
      "Please complete all required fields."
    );

    if(invalid)invalid.focus();
    return;
  }

  const params=new URLSearchParams();

  const put=(title,value)=>{
    const item=items[title];

    if(
      item&&
      item.entry!=null&&
      value!==""&&
      value!=null
    ){
      params.append(
        "entry."+item.entry,
        value
      );
    }
  };

  put("Full name",$("name").value.trim());
  put("Business name",$("biz").value.trim());
  put("Email",$("email").value.trim());
  put("Phone",$("phone").value.trim());

  put(
    "Current website (if any)",
    $("site").value.trim()
  );

  put("Plan",$("pkg").value);

  put(
    "What does your business do?",
    $("what").value.trim()
  );

  document.querySelectorAll(
    '#addons input[type="checkbox"]:checked'
  ).forEach(cb=>{
    put("Features you want",cb.value);
  });

  put(
    "When do you want to launch?",
    $("when").value
  );

  put(
    "Anything else? (sites you like, colors, logo status)",
    $("notes").value.trim()
  );

  if(
    items["Contact consent"]&&
    items["Contact consent"].choices&&
    items["Contact consent"].choices.length
  ){
    put(
      "Contact consent",
      items["Contact consent"].choices[0]
    );
  }

  const button=$("submitBtn");

  button.disabled=true;
  button.textContent="Sending...";

  try{
    await fetch(FORM_MAP.action,{
      method:"POST",
      mode:"no-cors",
      body:params
    });

    form.reset();
    calc();

    setMsg(
      "ok",
      "Request submitted. We'll follow up within one business day."
    );

  }catch(error){

    setMsg(
      "err",
      "Something went wrong. Please try again."
    );

  }finally{

    button.disabled=false;
    button.textContent="Get My Quote →";

  }
});
</script>
