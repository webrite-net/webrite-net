<script>

/* PROFILE PHOTO */

const PHOTO_ID =
  "1HncjnvCaNSV1ROMVOnjgIo1HqxxEpS4D";

const photoFrame =
  document.getElementById("photoFrame");

const profileImage = new Image();

profileImage.alt =
  "Trey, founder and website builder at WebRite";

profileImage.src =
  "https://lh3.googleusercontent.com/d/" +
  PHOTO_ID +
  "=w900";

profileImage.onerror = function(){

  photoFrame.innerHTML =
    '<span class="photo-fallback">T</span>';

};

photoFrame.appendChild(profileImage);


/* PORTFOLIO */

const PROJECTS = [

  {
    name:"In Home Infusion",
    type:"Mobile IV Therapy · WordPress + Automation",
    url:"https://inhomeinfusion.com",
    description:
      "The mobile IV therapy company I founded. Patients across 30+ markets can explore treatments, review pricing, and request appointments."
  },

  {
    name:"Pour Live",
    type:"Private Bartending · Google Sites",
    url:"https://www.pourlive.com",
    description:
      "My private event bartending business, featuring a professional website, automated estimates, and booking inquiries."
  },

  {
    name:"Legal Console",
    type:"Legal Staffing · WordPress",
    url:"https://legalconsole.net",
    description:
      "My legal recruiting venture, designed to connect legal professionals with law firms through a professional digital presence."
  }

];

function escapeHTML(value){

  return String(value).replace(
    /[&<>"']/g,
    character => ({
      "&":"&amp;",
      "<":"&lt;",
      ">":"&gt;",
      '"':"&quot;",
      "'":"&#39;"
    }[character])
  );

}

document.getElementById("projects").innerHTML =
  PROJECTS.map(project => `

    <article class="card project">

      <div class="project-type">
        ${escapeHTML(project.type)}
      </div>

      <h3>
        ${escapeHTML(project.name)}
      </h3>

      <p>
        ${escapeHTML(project.description)}
      </p>

      <a
        class="project-link"
        href="${escapeHTML(project.url)}"
        target="_blank"
        rel="noopener noreferrer"
      >
        Visit Website →
      </a>

    </article>

  `).join("");

</script>
