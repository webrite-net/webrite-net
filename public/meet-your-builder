<style>
:root{
  --blue:#2F5BFF;
  --ink:#0B0B12;
  --bg:#EEF0F4;
  --white:#FFFFFF;
  --muted:#5A5F6E;
  --line:#D9DCE4;
}

*{
  box-sizing:border-box;
}

html,body{
  margin:0;
  padding:0;
  height:auto;
  overflow-x:hidden;
  background:var(--bg);
  color:var(--ink);
  font-family:Inter,Arial,sans-serif;
  line-height:1.5;
}

.wrap{
  max-width:1050px;
  margin:auto;
  padding:35px 22px 15px;
}

h1,h2,h3,.brand{
  font-family:"Space Grotesk",sans-serif;
}

/* BRAND */

.brand{
  font-size:42px;
  font-weight:700;
  letter-spacing:-2px;
  line-height:1.1;
}

.brand span{
  color:var(--blue);
}

.tagline{
  font-size:11px;
  font-weight:700;
  letter-spacing:3px;
  color:var(--blue);
}

/* HEADER */

.header{
  padding-bottom:30px;
  border-bottom:1px solid var(--line);
}

.header h1{
  font-size:clamp(32px,5vw,44px);
  margin:25px 0 12px;
  letter-spacing:-1px;
  line-height:1.1;
}

.header p{
  color:var(--muted);
  max-width:720px;
  margin:0 0 12px;
}

.header .lead{
  font-size:17px;
  color:var(--ink);
  font-weight:500;
}

.back{
  display:inline-block;
  margin-top:16px;
  color:var(--blue);
  text-decoration:none;
  font-weight:700;
  font-size:14px;
}

.back:hover{
  text-decoration:underline;
}

/* INTRODUCTION */

.intro{
  display:grid;
  grid-template-columns:260px minmax(0,1fr);
  gap:25px;
  align-items:start;
  margin-top:30px;
}

.photo{
  background:white;
  border:1px solid var(--line);
  border-radius:18px;
  padding:10px;
  min-width:0;
}

.photo-frame{
  aspect-ratio:4/5;
  border-radius:12px;
  overflow:hidden;
  background:linear-gradient(135deg,#2F5BFF,#0B0B12);
  display:flex;
  align-items:center;
  justify-content:center;
}

.photo-frame img{
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
  object-position:center top;
}

.photo-fallback{
  font-family:"Space Grotesk",sans-serif;
  color:white;
  font-size:80px;
  font-weight:700;
}

.photo-caption{
  text-align:center;
  padding:12px 5px 5px;
}

.photo-caption strong{
  display:block;
  font-size:15px;
}

.photo-caption span{
  display:block;
  color:var(--muted);
  font-size:12px;
  margin-top:3px;
}

.intro-panel{
  background:white;
  border:1px solid var(--line);
  border-radius:18px;
  padding:25px;
}

.intro-panel h2{
  margin:0 0 14px;
  font-size:25px;
}

.intro-panel p{
  color:var(--muted);
  font-size:14px;
  margin:0 0 13px;
}

.intro-panel p:last-child{
  margin-bottom:0;
}

.intro-panel strong{
  color:var(--ink);
}

/* SECTIONS */

h2.section-title{
  font-size:28px;
  margin:35px 0 17px;
  letter-spacing:-.6px;
}

.section-note{
  color:var(--muted);
  font-size:14px;
  margin:-7px 0 17px;
  max-width:720px;
}

/* CARDS */

.cards{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:15px;
}

.card{
  background:white;
  border:1px solid var(--line);
  border-radius:18px;
  padding:22px;
  min-width:0;
}

.card-number{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width:38px;
  height:38px;
  border-radius:11px;
  background:#EDF1FF;
  color:var(--blue);
  font-family:"Space Grotesk",sans-serif;
  font-weight:700;
  font-size:16px;
  margin-bottom:14px;
}

.card h3{
  margin:0 0 9px;
  font-size:19px;
  letter-spacing:-.3px;
}

.card p{
  color:var(--muted);
  font-size:13px;
  margin:0;
}

/* PORTFOLIO */

.project{
  display:flex;
  flex-direction:column;
}

.project-type{
  color:var(--blue);
  font-size:12px;
  font-weight:700;
  margin:0 0 10px;
}

.project h3{
  font-size:20px;
}

.project p{
  flex:1;
}

.project-link{
  display:inline-flex;
  align-items:center;
  align-self:flex-start;
  margin-top:17px;
  padding:10px 16px;
  border:1px solid var(--blue);
  border-radius:999px;
  color:var(--blue);
  font-size:13px;
  font-weight:700;
  text-decoration:none;
}

.project-link:hover{
  background:var(--blue);
  color:white;
}

/* BENEFITS */

.benefits{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:15px;
}

.benefit{
  background:white;
  border:1px solid var(--line);
  border-radius:15px;
  padding:19px;
  display:flex;
  align-items:flex-start;
  gap:12px;
}

.check{
  width:25px;
  height:25px;
  background:#EDF1FF;
  color:var(--blue);
  border-radius:8px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:16px;
  font-weight:700;
  flex:none;
}

.benefit strong{
  display:block;
  font-size:14px;
  margin-bottom:5px;
}

.benefit p{
  font-size:13px;
  color:var(--muted);
  margin:0;
}

/* CTA */

.cta{
  margin-top:38px;
  background:var(--ink);
  color:white;
  border-radius:18px;
  padding:28px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:22px;
}

.cta h2{
  font-size:27px;
  margin:0 0 8px;
}

.cta p{
  color:#C9CCD6;
  font-size:14px;
  margin:0;
  max-width:560px;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:48px;
  padding:0 23px;
  background:var(--blue);
  color:white;
  border:0;
  border-radius:999px;
  font:700 15px Inter,sans-serif;
  text-decoration:none;
  white-space:nowrap;
}

.btn:hover{
  background:#2146DC;
}

/* FOOTER — MATCHES GET A QUOTE */

.footer{
  margin-top:50px;
  padding-top:25px;
  border-top:1px solid var(--line);
  display:flex;
  flex-wrap:wrap;
  justify-content:space-between;
  align-items:flex-start;
  gap:20px;
}

.footer .brand{
  font-size:42px;
}

.footer a{
  color:var(--blue);
  text-decoration:none;
  font-size:14px;
  font-weight:600;
}

.footer a:hover{
  text-decoration:underline;
}

.footer p{
  width:100%;
  font-size:12px;
  color:var(--muted);
  margin:0;
}

/* TABLET */

@media(max-width:800px){

  .intro{
    grid-template-columns:210px minmax(0,1fr);
    gap:18px;
  }

  .cards{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

}

/* MOBILE */

@media(max-width:560px){

  .wrap{
    padding:25px 18px 15px;
  }

  .header h1{
    font-size:32px;
  }

  .header{
    padding-bottom:23px;
  }

  .intro{
    grid-template-columns:1fr;
    gap:15px;
    margin-top:23px;
  }

  .photo{
    max-width:270px;
    width:100%;
    margin:auto;
  }

  .intro-panel{
    padding:20px;
  }

  .intro-panel h2{
    font-size:23px;
  }

  h2.section-title{
    font-size:25px;
    margin:30px 0 15px;
  }

  .cards{
    grid-template-columns:1fr;
    gap:12px;
  }

  .card{
    padding:20px;
  }

  .benefits{
    grid-template-columns:1fr;
    gap:11px;
  }

  .benefit{
    padding:17px;
  }

  .cta{
    flex-direction:column;
    align-items:flex-start;
    margin-top:30px;
    padding:23px;
  }

  .cta h2{
    font-size:24px;
  }

  .btn{
    width:100%;
  }

  .footer{
    margin-top:35px;
    padding-top:20px;
    gap:16px;
  }

  .footer .brand{
    font-size:36px;
  }

  .footer a{
    font-size:13px;
  }

}

/* PREVENT UNNECESSARY BOTTOM SPACE */

body{
  min-height:0;
}

.wrap::after{
  content:none;
}

